# 复制为 .env 后填写真实值（不要提交到 Git）

# 语雀 Token（必填）：个人设置 → Token
YUQUE_TOKEN=你的语雀 Token

# 知识库空间 / 仓库
YUQUE_LOGIN=wangyanling-xsdvq
YUQUE_REPO=vf1lt7
YUQUE_HOST=https://www.yuque.com

# 售后反馈写入的语雀文档（不在检索助手中展示）
YUQUE_FEEDBACK_LOGIN=wangyanling-xsdvq
YUQUE_FEEDBACK_REPO=ezw77w
YUQUE_FEEDBACK_SLUG=qr67p7rx343mvp9g

# 大模型（OpenRouter，推荐千问重排）
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen-2.5-72b-instruct

# 本地向量召回（同步后写入 data/embeddings，原文仍在语雀）
# 与 LLM 共用同一 API Key；设 EMBEDDING_ENABLED=false 可关闭
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=qwen/qwen3-embedding-4b
DATA_DIR=data

# 语雀知识库 Webhook（消息推送）。地址示例：
# http://你的公网IP:8787/api/yuque/webhook?token=下面的密钥
# 勾选：发布文档、更新文档。未配置密钥时不校验 token。
YUQUE_WEBHOOK_SECRET=请改成随机字符串
YUQUE_WEBHOOK_DEBOUNCE_SECONDS=12

# 服务配置
HOST=0.0.0.0
PORT=8787
SYNC_INTERVAL_SECONDS=600
APP_TITLE=孚盟MX 智能检索助手
